layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign pages = site.pages | where_exp: "item", "item.url != '/sitemap.xml'" %}{% for item in pages %}{% if item.url and item.url != '/404.html' and item.url != '/feed.xml' %}<url><loc>{{ item.url | absolute_url | xml_escape }}</loc></url>{% endif %}{% endfor %}
{% for post in site.posts %}<url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>{% endfor %}
</urlset>
